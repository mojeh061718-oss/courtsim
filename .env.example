# --- Grok 4.3 provider: pick ONE of the two blocks below ---
# Both endpoints are OpenAI-compatible; the app works identically either way.
# With no key at all, CourtSim runs in offline demo mode (deterministic mock
# agents — fully playable, no AI quality).

# Option 1 (default): native SpaceXAI API — key from console.x.ai.
# Includes Agent Tools web search for the /api/research case-refresh endpoint.
LLM_PROVIDER=xai
GROK_API_KEY=
#GROK_MODEL=grok-4.3
#GROK_BASE_URL=https://api.x.ai/v1

# Option 2: AWS-native via Amazon Bedrock (bedrock-mantle endpoint).
# Generate a Bedrock API key in the Bedrock console; model xai.grok-4.3.
# Available regions: us-east-1, us-east-2, us-west-2 (+ GovCloud US-West).
#LLM_PROVIDER=bedrock
#AWS_REGION=us-east-1
#AWS_BEARER_TOKEN_BEDROCK=
#GROK_MODEL=xai.grok-4.3
#GROK_BASE_URL=https://bedrock-mantle.us-east-1.api.aws/openai/v1

# --- Server ---
PORT=3000

# --- Trial pacing / cost knobs ---
MAX_AI_WITNESSES=3        # witnesses the AI calls in its case-in-chief
MAX_AI_QUESTIONS=6        # questions per AI examination
JURY_SIZE=12              # full panel; lower it to cheapen deliberation
MAX_DELIB_ROUNDS=4        # rounds before a hung count is accepted
JUROR_ALIASING=1          # 1 = blind jurors to real-world names via aliases
