# --- Grok (xAI) API — the AI courtroom brain ---
# Get a key at https://console.x.ai. Without a key, CourtSim runs in offline
# demo mode with deterministic mock agents (fully playable, no AI quality).
GROK_API_KEY=
GROK_MODEL=grok-4
GROK_BASE_URL=https://api.x.ai/v1

# --- Server ---
PORT=3000

# --- Trial pacing / cost knobs ---
MAX_AI_WITNESSES=3        # witnesses the AI calls in its case-in-chief
MAX_AI_QUESTIONS=6        # questions per AI examination
JURY_SIZE=12              # full panel; lower it to cheapen deliberation
MAX_DELIB_ROUNDS=4        # rounds before a hung count is accepted
JUROR_ALIASING=1          # 1 = blind jurors to real-world names via aliases
